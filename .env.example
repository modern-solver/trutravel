# Postgres connection string for packages/db (Prisma).
DATABASE_URL="postgresql://user:password@localhost:5432/trutravel?schema=public"

# HMAC secret for apps/web's session cookie signing (apps/web/lib/session.ts).
# Falls back to an insecure dev value with a loud console warning if unset — T4 owns real secret
# management before any non-local deployment (docs/architecture/platform-architecture.md §8).
SESSION_SECRET="change-me-to-a-real-random-secret"
